{
  "name": "accountable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "uv sync",
    "dev": "node scripts/dev.mjs",
    "seed": "uv run python -m accountable.seed",
    "test": "npm run test:types && npm run test:backend && npm run test:frontend && npm run test:e2e",
    "test:types": "npm run typecheck --workspace frontend",
    "test:backend": "uv run pytest",
    "test:frontend": "npm run test --workspace frontend",
    "test:e2e": "playwright test",
    "api:types": "node scripts/api-types.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "open": "^11.0.4",
    "openapi-typescript": "^7.13.0",
    "tree-kill": "^1.2.2",
    "typescript": "~5.9.3"
  }
}
